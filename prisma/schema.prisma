generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(INVENTORY_MANAGER)
  createdAt    DateTime @default(now())
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Warehouse {
  id   String @id @default(cuid())
  name String
}