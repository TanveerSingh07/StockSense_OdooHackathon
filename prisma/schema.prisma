generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(INVENTORY_MANAGER)
  createdAt    DateTime @default(now())
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Warehouse {
  id   String @id @default(cuid())
  name String
}

model Supplier {
  id       String    @id @default(cuid())
  name     String
  receipts Receipt[]
}

enum DocStatus {
  DRAFT
  DONE
}

model Receipt {
  id          String        @id @default(cuid())
  supplierId  String
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  warehouseId String
  status      DocStatus     @default(DRAFT)
  lines       ReceiptLine[]
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id])
  productId String
  quantity  Int
}

model DeliveryOrder {
  id          String         @id @default(cuid())
  customer    String
  warehouseId String
  status      DocStatus      @default(DRAFT)
  lines       DeliveryLine[]
}

model DeliveryLine {
  id        String        @id @default(cuid())
  orderId   String
  order     DeliveryOrder @relation(fields: [orderId], references: [id])
  productId String
  quantity  Int
}

model StockLevel {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int    @default(0)

  @@unique([productId, warehouseId])
}

model StockLedger {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  change      Int
  reason      String
  refId       String
  createdAt   DateTime @default(now())
}